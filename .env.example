# Lokal geliştirme: cp .env.example .env
AUTH_MODE=dev                       # giriş yok, sahte kullanıcı
QDRANT_URL=http://localhost:6333    # docker compose up -d qdrant

# LLM: OpenAI uyumlu herhangi bir uç (vLLM, LiteLLM, OpenAI...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Embedding: boş bırakılırsa LLM_* değerleri kullanılır
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                  # modelin vektör boyutuyla aynı olmalı

# Sohbet geçmişi: lokalde sqlite
DATABASE_URL=sqlite+aiosqlite:///./data/chat.db

# İndekslenecek repo listesi (sources.example.yaml'dan kopyala)
SOURCES_FILE=./sources.yaml

# Oturum çerezi imzası; üretimde rastgele uzun bir değer
SESSION_SECRET=change-me

# Repo token'ları (sources.yaml içindeki token_env adları)
# GITHUB_TOKEN=
# AZURE_DEVOPS_PAT=
